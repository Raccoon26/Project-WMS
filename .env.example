# Development only; copy then run pnpm dev:setup to generate a local password safely.
NODE_ENV=development
DATABASE_URL=postgresql://wms_dev:replace-with-local-value@127.0.0.1:5432/wms_dev
WMS_DEV_PASSWORD=replace-with-local-value
HOST=127.0.0.1
API_PORT=3001
WORKER_PORT=3002
DB_TIMEOUT_MS=1000
DB_POOL_MAX=5
# AUTH_ENCRYPTION_KEY: separate 32-byte Base64 key; pnpm auth:setup generates it in ignored .env.
# AUTH_ORIGIN: exact browser origin; auth:setup uses http://127.0.0.1:5173 for loopback development.
# Never put this key in VITE_ variables, Git, logs, CI artifacts or the same operational backup as ciphertext.
